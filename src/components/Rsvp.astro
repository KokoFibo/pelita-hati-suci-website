---
import Icon from './Icon.astro';
interface Props { form: any; uid: string }
const { form, uid } = Astro.props;
---
<div class="formcard" data-form-wrap data-reveal>
  <div data-form-body>
    <h3>{form.title}</h3>
    {form.lead && <p class="flead">{form.lead}</p>}
    <form data-rsvp>
      <div class="fgrid">
        {form.fields.map((f: any) => (
          <div class:list={['field', { 'field--full': f.full }]}>
            <label for={`${uid}-${f.name}`}>{f.label}{f.required && <i aria-hidden="true"> *</i>}</label>
            {f.type === 'select' ? (
              <select class="input" id={`${uid}-${f.name}`} name={f.name} required={f.required}>
                <option value="" disabled selected hidden></option>
                {f.options.map((o: string) => <option value={o}>{o}</option>)}
              </select>
            ) : f.type === 'textarea' ? (
              <textarea class="input" id={`${uid}-${f.name}`} name={f.name} rows="3"></textarea>
            ) : (
              <input class="input" id={`${uid}-${f.name}`} name={f.name} type={f.type} required={f.required} min={f.type === 'number' ? 1 : undefined} inputmode={f.type === 'tel' ? 'tel' : undefined} />
            )}
          </div>
        ))}
        <label class="check field--full"><input type="checkbox" required /><span>{form.consent}</span></label>
      </div>
      <button class="btn btn--primary btn--block" type="submit" style="margin-top:1.4rem">{form.submit}</button>
    </form>
  </div>
  <div class="fsuccess" data-form-success hidden>
    <span class="icon-bubble"><Icon name="check" /></span>
    <h3>{form.success.title}</h3>
    <p>{form.success.text}</p>
    <button class="btn btn--ghost btn--sm" type="button" data-form-again>{form.success.again}</button>
  </div>
</div>
