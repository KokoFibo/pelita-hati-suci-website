---
interface Props { eyebrow?: string; title: string; lead?: string; center?: boolean; jade?: boolean }
const { eyebrow, title, lead, center = false, jade = false } = Astro.props;
---
<div class:list={['sec-head', { 'sec-head--center': center }]} data-reveal>
  {eyebrow && <span class:list={['eyebrow', { 'eyebrow--jade': jade }]}>{eyebrow}</span>}
  <h2 class="h2" data-split>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
</div>
