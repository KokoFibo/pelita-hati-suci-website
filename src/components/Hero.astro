---
import Icon from './Icon.astro';
import Pic from './Pic.astro';
import Button from './Button.astro';
import type { Lang } from '../i18n/utils';
interface Props { data: any; lang: Lang; badgeStyle?: 'cards' | 'chips' }
const { data, lang, badgeStyle = 'chips' } = Astro.props;
---
<section class="hero" data-hero>
  <div class="container hero__grid">
    <div class="hero__copy">
      <span class="chip" data-hero-item><Icon name={data.chip.icon} />{data.chip.text}</span>
      <h1 class="h1" data-split>{data.title}</h1>
      <p class="lead" data-hero-item>{data.lead}</p>
      <div class="hero__actions" data-hero-item>
        {data.actions.map((a: any) => <Button {...a} lang={lang} />)}
      </div>
      {badgeStyle === 'cards' ? (
        <div class="hero__badges" data-hero-item>
          {data.badges.map((b: any) => (
            <div class="mini"><Icon name={b.icon} /><div><b>{b.title}</b><span class="t">{b.text}</span></div></div>
          ))}
        </div>
      ) : (
        <div class="hero__badges--inline" data-hero-item>
          {data.badges.map((b: any) => <span class="chip chip--jade"><Icon name={b.icon} />{b.title}</span>)}
        </div>
      )}
    </div>
    <div class="hero__media">
      <svg class="hero__ring" viewBox="0 0 100 100" aria-hidden="true" data-spin>
        <circle cx="50" cy="50" r="46" fill="none" stroke="var(--gold)" stroke-width="0.8" stroke-dasharray="2 4" />
        <circle cx="50" cy="50" r="38" fill="none" stroke="var(--jade)" stroke-width="0.6" stroke-dasharray="1 3" />
      </svg>
      <div class="hero__frame" data-hero-frame>
        <Pic k={data.image} alt={data.alt} eager class="cover" data-parallax />
      </div>
      <div class="fcard" data-hero-item data-float>
        <b>{data.quote.title}</b><span>{data.quote.text}</span>
      </div>
      <div class="ftag" data-hero-item><Icon name={data.tag.icon} /><span>{data.tag.text}</span></div>
    </div>
  </div>
</section>
